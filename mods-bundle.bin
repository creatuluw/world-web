Player:# Structure overrides: ADR-0005 â€” the Construction Yard and the undeployed
# MCV are permanently indestructible; the damage gate enforces it plus the
# offline-protection rules and records combat for the arming delay.

FACT:
MCV:# World actor overrides: the continuous-world server traits ride on top of
# Tiberian Dawn's standard world actor (merged from cnc|rules/world.yaml).

World:# Minimal headless tileset for the World mod (spec section 11).
# Terrain colors drive the auto-generated map preview; no sprite assets
# exist in this mod â€” the continuous world server never renders.

General:
	Name: tileset-world
	Id: WORLD
	EditorTemplateOrder: Terrain
	HeightDebugColors: 880000
	MinHeightColorBrightness: 1.0
	MaxHeightColorBrightness: 1.0

Terrain:
	TerrainType@Clear:
		Type: Clear
		TargetTypes: Ground
		Color: 4A5D3A

Templates:
	Template@0:
		Images: clear
		Size: 1,1
		PickAny: True
		Categories: Terrain
		Tiles:
			0: Clear

^Chrome:
	Image: chrome.png
	Image2x: chrome-2x.png
	Image3x: chrome-3x.png

logos:
	Inherits: ^Chrome
	Regions:
		eva: 769, 320, 128, 64
		nod-load: 0, 256, 256, 256
		gdi-load: 256, 256, 256, 256

